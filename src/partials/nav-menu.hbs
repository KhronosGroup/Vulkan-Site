{{#with page.navigation}}
<div class="nav-panel-menu is-active" data-panel="menu">
  <nav class="nav-menu" aria-label="Navigation menu">
    <button class="nav-menu-toggle" aria-label="Expand all navigation items" aria-expanded="false" style="display: none"></button>
    {{#with @root.page.componentVersion}}
    <h2 class="title"><a href="{{{relativize ./url}}}">{{./title}}</a></h2>
    {{/with}}
{{> nav-tree navigation=this}}
  </nav>
</div>
{{/with}}
